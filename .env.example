# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" nunca é enviado para o GitHub (veja o .gitignore).

# Porta em que o servidor roda localmente
PORT=3000

# Supabase (banco de dados)
# Encontrados em Project Settings > API, no painel do Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# RD Station CRM
# Token da conta, em Configurações > Integrações > API no painel do RD Station.
# Dá acesso total à base de clientes e negociações: trate como senha e troque
# se ele vazar em algum lugar.
RD_STATION_TOKEN=
